// charge-ops-autopilot on Azure: the CSMS and the autopilot as Container Apps, PostgreSQL for the
// OCPP record, Azure ML for training, the registry and the online endpoint, API Management as the
// AI gateway in front of Microsoft Foundry models, Key Vault, and Log Analytics / App Insights.
// Validated in CI with `az bicep build`; deploy with azure/deploy.sh (not run from this repository).

targetScope = 'resourceGroup'

@description('Short environment name, e.g. dev or prod')
param env string = 'dev'
param location string = resourceGroup().location
@description('Daily AI spend per use case (EUR); alerts at 80% and 100%')
param useCaseBudgets object = {
  'incident-reader': 6
  'note-labeler': 2
  'dispatch-brief': 2
}
@secure()
param postgresAdminPassword string
param csmsImage string = 'ghcr.io/manojrevenkar12-web/charge-ops-autopilot:latest'

var prefix = 'cpa-${env}'
// generated by `cpa apim` from config/gateway.yaml (Bicep loads files at compile time, so one line each)
var policies = {
  'incident-reader': loadTextContent('../apim/policies/incident-reader.xml')
  'note-labeler': loadTextContent('../apim/policies/note-labeler.xml')
  'dispatch-brief': loadTextContent('../apim/policies/dispatch-brief.xml')
}
var tags = { system: 'charge-ops-autopilot', env: env, owner: 'ai-unit' }

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: '${prefix}-logs'
  location: location
  tags: tags
  properties: { sku: { name: 'PerGB2018' }, retentionInDays: 30 }
}

resource insights 'Microsoft.Insights/components@2020-02-02' = {
  name: '${prefix}-insights'
  location: location
  kind: 'web'
  tags: tags
  properties: { Application_Type: 'web', WorkspaceResourceId: logs.id }
}

resource vault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: '${prefix}-kv'
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
    enableSoftDelete: true
    enablePurgeProtection: true
  }
}

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: replace('${prefix}store', '-', '')
  location: location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: { minimumTlsVersion: 'TLS1_2', allowBlobPublicAccess: false }
}

resource registry 'Microsoft.ContainerRegistry/registries@2023-07-01' = {
  name: replace('${prefix}acr', '-', '')
  location: location
  tags: tags
  sku: { name: 'Basic' }
  properties: { adminUserEnabled: false }
}

// Azure ML: training jobs, the model registry (champion / challenger aliases) and the online endpoint
resource ml 'Microsoft.MachineLearningServices/workspaces@2024-10-01' = {
  name: '${prefix}-ml'
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    friendlyName: 'charge-ops models'
    storageAccount: storage.id
    keyVault: vault.id
    applicationInsights: insights.id
    containerRegistry: registry.id
    publicNetworkAccess: 'Disabled'
  }
}

resource pg 'Microsoft.DBforPostgreSQL/flexibleServers@2024-08-01' = {
  name: '${prefix}-pg'
  location: location
  tags: tags
  sku: { name: 'Standard_D2ds_v5', tier: 'GeneralPurpose' }
  properties: {
    version: '16'
    administratorLogin: 'cpaadmin'
    administratorLoginPassword: postgresAdminPassword
    storage: { storageSizeGB: 128 }
    backup: { backupRetentionDays: 14, geoRedundantBackup: 'Disabled' }
    highAvailability: { mode: 'ZoneRedundant' }
  }
}

resource apps 'Microsoft.App/managedEnvironments@2024-03-01' = {
  name: '${prefix}-apps'
  location: location
  tags: tags
  properties: {
    appLogsConfiguration: {
      destination: 'log-analytics'
      logAnalyticsConfiguration: { customerId: logs.properties.customerId, sharedKey: logs.listKeys().primarySharedKey }
    }
  }
}

// The CSMS keeps WebSocket connections to thousands of stations: sticky sessions, scale on connections
resource csms 'Microsoft.App/containerApps@2024-03-01' = {
  name: '${prefix}-csms'
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    managedEnvironmentId: apps.id
    configuration: {
      ingress: { external: true, targetPort: 9000, transport: 'http', stickySessions: { affinity: 'sticky' } }
      secrets: [ { name: 'database-url', keyVaultUrl: '${vault.properties.vaultUri}secrets/database-url', identity: 'system' } ]
    }
    template: {
      containers: [ {
        name: 'csms'
        image: csmsImage
        command: [ 'cpa', 'serve-csms' ]
        env: [ { name: 'CPA_DATABASE_URL', secretRef: 'database-url' } ]
        resources: { cpu: json('1.0'), memory: '2Gi' }
      } ]
      scale: { minReplicas: 2, maxReplicas: 10, rules: [ { name: 'connections', http: { metadata: { concurrentRequests: '2000' } } } ] }
    }
  }
}

// The autopilot runs once per replica set (leader election through a Postgres advisory lock)
resource autopilot 'Microsoft.App/containerApps@2024-03-01' = {
  name: '${prefix}-autopilot'
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    managedEnvironmentId: apps.id
    configuration: {
      ingress: { external: false, targetPort: 8000 }
      secrets: [ { name: 'database-url', keyVaultUrl: '${vault.properties.vaultUri}secrets/database-url', identity: 'system' } ]
    }
    template: {
      containers: [ {
        name: 'autopilot'
        image: csmsImage
        command: [ 'cpa', 'serve-api' ]
        env: [
          { name: 'CPA_DATABASE_URL', secretRef: 'database-url' }
          { name: 'CPA_GATEWAY_URL', value: '${gateway.properties.gatewayUrl}/ai' }
          { name: 'APPLICATIONINSIGHTS_CONNECTION_STRING', value: insights.properties.ConnectionString }
        ]
        resources: { cpu: json('2.0'), memory: '4Gi' }
        probes: [ { type: 'Readiness', httpGet: { path: '/health', port: 8000 } } ]
      } ]
      scale: { minReplicas: 2, maxReplicas: 2 }
    }
  }
}

// API Management as the AI gateway: one operation per use case, policies from azure/apim/policies
resource gateway 'Microsoft.ApiManagement/service@2024-05-01' = {
  name: '${prefix}-apim'
  location: location
  tags: tags
  sku: { name: 'StandardV2', capacity: 1 }
  identity: { type: 'SystemAssigned' }
  properties: { publisherEmail: 'ai-unit@example.com', publisherName: 'AI unit' }
}

resource aiApi 'Microsoft.ApiManagement/service/apis@2024-05-01' = {
  parent: gateway
  name: 'ai'
  properties: { displayName: 'AI use cases', path: 'ai', protocols: [ 'https' ], subscriptionRequired: true }
}

resource useCaseOps 'Microsoft.ApiManagement/service/apis/operations@2024-05-01' = [for uc in items(useCaseBudgets): {
  parent: aiApi
  name: uc.key
  properties: { displayName: uc.key, method: 'POST', urlTemplate: '/${uc.key}' }
}]

resource useCasePolicies 'Microsoft.ApiManagement/service/apis/operations/policies@2024-05-01' = [for (uc, i) in items(useCaseBudgets): {
  parent: useCaseOps[i]
  name: 'policy'
  properties: { format: 'rawxml', value: policies[uc.key] }
}]

// Cost: a budget per use case on the AI resources, alerting the owners
resource budgets 'Microsoft.Consumption/budgets@2023-11-01' = [for uc in items(useCaseBudgets): {
  name: '${prefix}-${uc.key}'
  properties: {
    category: 'Cost'
    amount: uc.value * 31
    timeGrain: 'Monthly'
    timePeriod: { startDate: '2026-11-01' }
    filter: { tags: { name: 'use-case', operator: 'In', values: [ uc.key ] } }
    notifications: {
      at80: { enabled: true, operator: 'GreaterThan', threshold: 80, contactEmails: [ 'ai-unit@example.com' ] }
      at100: { enabled: true, operator: 'GreaterThan', threshold: 100, contactEmails: [ 'ai-unit@example.com' ] }
    }
  }
}]

output csmsUrl string = 'wss://${csms.properties.configuration.ingress.fqdn}'
output mlWorkspace string = ml.name
output gatewayUrl string = gateway.properties.gatewayUrl
